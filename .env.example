# Google Flood Forecasting API key.
# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, that would ship it to the browser.
# Enable the "Flood Forecasting API" in Google Cloud and restrict the key to it.
GOOGLE_FLOOD_API_KEY=

# How long a successful live result is cached, in seconds. Flood status changes
# on the order of minutes; caching is what keeps Google API usage low.
FLOOD_CACHE_SECONDS=300

# Upstream request timeout, in milliseconds.
UPSTREAM_TIMEOUT_MS=10000

# Optional. Overrides the Google Flood Forecasting base URL. Useful for staging
# or pointing at a mock during testing. Deployer-set only; not user-controllable.
GOOGLE_FLOOD_BASE_URL=

# Rate limiting. REQUIRED in production: without these the route falls back
# to an in-memory per-instance limiter, which is not effective on serverless.
# Create a free Redis database at https://upstash.com and paste the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX=30
